GAME_MODE=live
PORT=8080
CONTROLLER_KEY=change-me
WALLET=http
WALLET_URL=https://platform.example.com/horse-api
WALLET_KEY=change-me-too   # shared secret used to sign wallet requests: 16+ random chars (openssl rand -hex 32)
#WALLET_KEY_ID=k1         # optional, sent as X-Key-Id so you can rotate keys
#WALLET_AUTH=hmac         # hmac (default, signed requests) or bearer
#NODE_ENV=production      # also makes the play-money mock wallet impossible
#ALLOW_MOCK_WALLET=1      # local testing only: WALLET=mock in live mode
CURRENCY=PHP
RTP=90                # 88-99, editable later in the controller (saved in data/settings.json)
# ODDS='{"1-2":60,...}'   # optional: change the odds (default: the video karera board); RTP follows from the odds
BET_MS=25000          # betting window per race
MIN_BET=100           # minor units (1.00)
MAX_BET=100000        # per combination
MAX_ROUND_STAKE=500000
#DAILY_LOSS_LIMIT=0        # default daily loss limit per player in minor units (0 = none); the platform can send one per player
#REALITY_CHECK_MIN=0       # default reality-check interval in minutes (0 = off); the platform can send one per player
#CURRENCY_LIMITS='{"JPY":{"minBet":100,"maxBet":50000,"maxRoundStake":1000000,"decimals":0}}'
#WEBHOOK_URL=https://platform.example.com/horse-events   # round.settled and big.win events, signed (WEBHOOK_KEY or WALLET_KEY)
#WEBHOOK_EVENTS=round.settled,big.win
#BIG_WIN_MIN=1000000       # payout (minor units) that triggers a big.win event
