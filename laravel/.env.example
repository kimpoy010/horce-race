APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- horse race game (config/horse.php) ---
HORSE_WALLET=mock              # mock = play money (never in production) | http = the platform's wallet API | none = registry clients only
# HORSE_WALLET_URL=https://platform.example/horse-api
# HORSE_WALLET_KEY=             # at least 16 random characters: openssl rand -hex 32
HORSE_CONTROLLER_KEY=          # operator key for /controller, /api/command and /api/clients (X-Controller-Key)
HORSE_CLIENTS_KEY=             # encrypts the client wallet/webhook secrets in the database; set once, keep it, back it up separately
# BINGO_DEFAULT_ON=false         # the 5-ball Bingo Pinball is hidden by default (Bingo Pinball 16 replaces it); true makes it available to every client again
# BINGO_DEFAULT_PAYTABLE=90      # its RTP version (88, 90, 92, 94 or 96) for clients that have no paytable of their own
# BINGO16_DEFAULT_ON=false        # Bingo Pinball 16 (16 balls, 16 slots, progressive jackpot): true = every client plays it; false = only clients that have it in their own games list
# BINGO16_JACKPOT_CONTRIBUTION_BP=148   # share of every stake that goes into the jackpot pool, in basis points (148 = 1.48%)
# BINGO16_JACKPOT_SEED=10000      # the pool starts at, and after every win restarts from, this amount in minor units (10000 = PHP 100.00), paid by the operator
# BINGO16_JACKPOT_CURRENCIES=PHP  # currencies that have the jackpot (one pool per currency, shared by the whole server)
# HORSE_ALLOW_MOCK_WALLET=true  # lets a registry client use a play-money wallet (local testing only)
# HORSE_TRUST_PROXY=true        # behind a reverse proxy: use X-Forwarded-For for the client API's IP allow list
HORSE_RTP=0.9
